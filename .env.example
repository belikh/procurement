# Procurement MCP — env template
# Copy to .env and fill for io+agent@jupiter.au
# Never commit .env

# Chinese aggregators (recommended primary for full width)
TMAPI_TOKEN=            # from https://console.tmapi.io/account/center — covers taobao/tmall/1688/pdd/jd
ELIM_API_TOKEN=         # from https://elim.asia — optional, for order creation flow
OTCOMMERCE_RAPIDAPI_KEY= # RapidAPI key for Otcommerce JD/Taobao fallback
RAPIDAPI_KEY=           # alias for above

# AliExpress official (moderate barrier — affiliate approval 1–2 days)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Australian — eBay AU (official, fully supports EBAY_AU)
# Create app at https://developer.ebay.com — use io+agent@jupiter.au
EBAY_APP_ID=
EBAY_CERT_ID=
# Optional: pre-fetched bearer to skip client-credentials flow
EBAY_OAUTH_TOKEN=

# Amazon AU — SP-API Far East or PA-API
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=jupiter-22

# Hosted scraper-APIs (you don't build scrapers — you call these)
SOCIAVAULT_API_KEY=     # https://sociavault.com — Facebook Marketplace AU
APIFY_TOKEN=            # https://console.apify.com/settings/integrations — Gumtree AU + OzBargain search actors
GUMTREE_APIFY_ACTOR=crawlerbros/gumtree-scraper
OZBARGAIN_APIFY_ACTOR=parseforge/ozbargain-australia-scraper
# eBay AU sold-price comps (what items ACTUALLY sold for)
EBAY_SOLD_APIFY_ACTOR=caffein.dev/ebay-sold-listings
# Amazon AU without PA-API credentials (hosted actor, ~40-70s per run)
AMAZON_APIFY_ACTOR=junglee/free-amazon-product-scraper
# Reverse image search: photo -> 1688/Alibaba/AliExpress/global suppliers
IMAGE_SEARCH_APIFY_ACTOR=dev00/alibaba-1688-aliexpress-reverse-image-search-api
# AU grocery trio (dromb series — unit pricing + specials)
WOOLWORTHS_APIFY_ACTOR=dromb/woolworths-au-product-search-catalog-unofficial
COLES_APIFY_ACTOR=dromb/coles-au-product-search-specials-stores-unofficial
ALDI_APIFY_ACTOR=dromb/aldi-au-product-search-catalog-unofficial

# Deal feeds — official RSS, no key needed (OzBargain/Cheapies publish these)
OZBARGAIN_FEED_URL=https://www.ozbargain.com.au/deals/feed
CHEAPIES_FEED_URL=https://www.cheapies.nz/deals/feed

# Keepa — official Amazon price-history API, covers amazon.com.au (domain 12).
# Optional; when set, amazon_au offers get price_history (90d avg/min) attached.
KEEPA_API_KEY=

# Postgres — fleet store on callisto (10.1.1.3:5432, jupiter db) per stack law
# If DATABASE_URL is set, the MCP server caches federated results and logs searches there.
# If unset, it runs stateless (in-memory only). Never hardcode secrets — use env / sops.
DATABASE_URL=postgresql://procurement:__SET_ME__@10.1.1.3:5432/jupiter
# Optional: override schema (default: procurement)
PROCUREMENT_PG_SCHEMA=procurement

# Behaviour
CNY_TO_AUD=0.215
PROCUREMENT_TIMEOUT_S=8
PROCUREMENT_INCLUDE_RAW=0
PROCUREMENT_CACHE_TTL_S=3600
