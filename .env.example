# Procurement MCP environment template.
# Copy to .env and fill in the keys you have. Every key is optional: a marketplace
# without its key returns a "missing_key" diagnostic. Empty values count as unset.
# .env is gitignored.

# --- Destination (default: Brisbane CBD) ---
SHIP_TO_COUNTRY=AU
SHIP_TO_POSTCODE=4000
# Centre and radius for pickup listings (Facebook Marketplace).
SHIP_TO_LAT=-27.4698
SHIP_TO_LNG=153.0251
PICKUP_RADIUS_KM=50

# --- Apify: one token runs the taobao, tmall, jd, 1688, amazon_au, ebay_sold,
#     woolworths, coles, aldi and gumtree lanes and search_by_image ---
# https://console.apify.com/settings/integrations
APIFY_TOKEN=
TAOBAO_APIFY_ACTOR=zen-studio/taobao-search-scraper
JD_APIFY_ACTOR=zen-studio/jd-com-search-scraper
ALI1688_APIFY_ACTOR=zen-studio/1688-wholesale-scraper
AMAZON_APIFY_ACTOR=junglee/free-amazon-product-scraper
EBAY_SOLD_APIFY_ACTOR=caffein.dev/ebay-sold-listings
WOOLWORTHS_APIFY_ACTOR=dromb/woolworths-au-product-search-catalog-unofficial
COLES_APIFY_ACTOR=dromb/coles-au-product-search-specials-stores-unofficial
ALDI_APIFY_ACTOR=dromb/aldi-au-product-search-catalog-unofficial
IMAGE_SEARCH_APIFY_ACTOR=dev00/alibaba-1688-aliexpress-reverse-image-search-api
GUMTREE_APIFY_ACTOR=crawlerbros/gumtree-scraper
# Gumtree AU blocks the actor without cookies exported from a real browser session.
GUMTREE_COOKIES=

# --- TMAPI: 1688 keyword search; item detail for taobao, tmall, 1688, jd, pdd ---
# https://console.tmapi.io/account/center   (TMAPI_API_TOKEN is accepted as an alias)
TMAPI_TOKEN=

# --- eBay AU Browse API ---
# https://developer.ebay.com   (EBAY_CLIENT_ID / EBAY_CLIENT_SECRET are accepted as aliases)
EBAY_APP_ID=
EBAY_CERT_ID=
# Optional pre-fetched bearer token; skips the client-credentials call.
EBAY_OAUTH_TOKEN=
# eBay account-deletion notifications, served at /ebay/notifications over HTTP.
# The endpoint must equal the URL registered in the eBay developer portal.
EBAY_DELETION_TOKEN=
EBAY_DELETION_ENDPOINT=https://procurement.jupiter.au/ebay/notifications

# --- Facebook Marketplace via SociaVault ---
# https://sociavault.com
SOCIAVAULT_API_KEY=

# --- Keepa: Amazon price history for get_price_history ---
# KEEPA_DOMAIN is Keepa's numeric id for amazon.com.au. Keepa's official clients
# list ids 1 to 12 and none is Australia, so price history stays off until you set
# the id your Keepa account documents.
KEEPA_API_KEY=
KEEPA_DOMAIN=

# --- Deal feeds: the sites' own RSS, no key ---
OZBARGAIN_FEED_URL=https://www.ozbargain.com.au/deals/feed
CHEAPIES_FEED_URL=https://www.cheapies.nz/deals/feed

# --- Freight forwarder estimate for taobao, tmall, 1688, jd, pdd offers ---
# Placeholders. Set these from your forwarder's rate card.
FORWARDER_RATE_AUD_PER_KG=12.0
FORWARDER_DEFAULT_WEIGHT_KG=0.5
FORWARDER_MIN_CHARGE_AUD=15.0
FORWARDER_FEE_PCT=0.0
GST_RATE=0.10

# --- Currency ---
CNY_TO_AUD=0.215
NZD_TO_AUD=0.92

# --- Postgres cache and search log (optional) ---
# Unset: the server keeps no state and search_history is unavailable.
DATABASE_URL=
PROCUREMENT_PG_SCHEMA=procurement
PROCUREMENT_CACHE_TTL_S=3600

# --- Behaviour ---
# Seconds allowed for a whole search. MCP clients commonly cut a tool call at 60 s.
PROCUREMENT_DEADLINE_S=55
# Timeout for one direct API call (eBay, TMAPI, feeds).
PROCUREMENT_TIMEOUT_S=8
# 1 adds each source's raw payload to offers.
PROCUREMENT_INCLUDE_RAW=0
# Serve streamable HTTP on 127.0.0.1:<port> at /mcp. Unset: stdio.
MCP_HTTP_PORT=
